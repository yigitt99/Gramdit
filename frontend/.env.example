# ============================================
# FRONTEND - ENVIRONMENT TEMPLATE (.env.example)
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# This template contains placeholder values only.
# Note: Variables MUST be prefixed with VITE_ to be exposed to client-side code

# ============================================
# API CONFIGURATION
# ============================================
# Backend API endpoint
VITE_API_BASE_URL=http://localhost:3000/api/v1
# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# ============================================
# APPLICATION INFORMATION
# ============================================
VITE_APP_NAME=Gramdit
VITE_APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Uncomment to enable debug mode (development only)
# VITE_ENABLE_DEBUG=false
# Uncomment to enable analytics
# VITE_ENABLE_ANALYTICS=false

# ============================================
# FUTURE: THIRD-PARTY SERVICE KEYS
# ============================================
# IMPORTANT: Only use PUBLIC keys for client-side code
# Never expose SECRET keys in client-side code

# Google OAuth (optional)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id

# GitHub OAuth (optional)
# VITE_GITHUB_CLIENT_ID=your_github_client_id

# Sentry Error Tracking (optional)
# VITE_SENTRY_DSN=your_sentry_dsn

# Analytics Services (optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# ============================================
# PRODUCTION RECOMMENDATIONS
# ============================================
# 1. Update VITE_API_BASE_URL to your production API endpoint
# 2. Only expose PUBLIC keys/IDs, never SECRET keys
# 3. Set VITE_ENABLE_DEBUG=false in production
# 4. Configure proper CORS policies on backend
# 5. Use HTTPS in production
# 6. Store sensitive values in build-time environment variables
# 7. Never commit this .env file to version control

