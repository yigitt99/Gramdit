# ============================================
# BACKEND - ENVIRONMENT TEMPLATE (.env.example)
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# This template contains placeholder values only.

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_DATABASE=gramdit

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis cache connection details
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ============================================
# API CONFIGURATION
# ============================================
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ============================================
# PGADMIN CONFIGURATION
# ============================================
# PostgreSQL admin panel credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=8080

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_jwt_secret_key_min_32_characters_recommended
JWT_EXPIRATION=24h

# ============================================
# FUTURE: EMAIL/SMTP CONFIGURATION
# ============================================
# Uncomment and set when email features are implemented
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@gramdit.com

# ============================================
# FUTURE: THIRD-PARTY SERVICES
# ============================================
# Uncomment and set when third-party integrations are added
# STRIPE_API_KEY=your_stripe_api_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ============================================
# PRODUCTION RECOMMENDATIONS
# ============================================
# Before deploying to production:
# 1. Use strong, random values for all passwords (min 32 characters)
# 2. Use a secure database host (not localhost)
# 3. Enable SSL/TLS for all connections
# 4. Use a secure Redis instance with password protection
# 5. Store sensitive values in a secret management system (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Never commit the actual .env file to version control
# 7. Use environment-specific CI/CD pipelines for deployments
