# ============================================
# GRAMDIT - ENVIRONMENT TEMPLATE (.env.example)
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# This template contains placeholder values only.

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_DATABASE=gramdit

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis cache connection details
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ============================================
# PGADMIN CONFIGURATION
# ============================================
# PostgreSQL admin panel credentials
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=8888

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000
VITE_APP_NAME=Gramdit
VITE_APP_VERSION=1.0.0

# ============================================
# BACKEND CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ============================================
# FUTURE: JWT CONFIGURATION
# ============================================
# Uncomment and set when JWT authentication is implemented
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRATION=24h

# ============================================
# FUTURE: EMAIL CONFIGURATION
# ============================================
# Uncomment and set when email features are implemented
# SMTP_HOST=your_smtp_server
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password

# ============================================
# FUTURE: OAUTH CONFIGURATION
# ============================================
# Uncomment and set when OAuth is implemented
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
